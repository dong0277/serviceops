# Local development only. Copy this file to .env and replace placeholder values.
APP_ENV=development
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
POSTGRES_DB=serviceops
POSTGRES_USER=serviceops
POSTGRES_PASSWORD=replace-with-a-local-only-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:8000
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
